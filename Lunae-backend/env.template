# Configuración del servidor
PORT=3000
NODE_ENV=development

# Configuración de base de datos DynamoDB
DYNAMODB_TABLE_NAME=Users
DYNAMODB_REGION=us-east-2

# Configuración de AWS - IMPORTANTE: Reemplaza con tus credenciales reales
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY_AWS_AQUI
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY_AWS_AQUI
AWS_S3_BUCKET=eleven-lunea-storage

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_super_seguro_aqui
JWT_EXPIRES_IN=24h

# Configuración de CORS
CORS_ORIGIN=http://192.168.1.11:3000,http://localhost:3000,http://localhost:19006

# Configuración de logs
LOG_LEVEL=debug

# INSTRUCCIONES DE CONFIGURACIÓN:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza las credenciales de AWS con las tuyas reales
# 3. Asegúrate de que tu usuario de AWS tenga permisos para DynamoDB
# 4. La tabla se creará automáticamente en la primera operación
# 5. Verifica que la región de AWS sea la correcta para tu cuenta

# PERMISOS MÍNIMOS REQUERIDOS EN AWS:
# - dynamodb:CreateTable
# - dynamodb:PutItem
# - dynamodb:GetItem
# - dynamodb:UpdateItem
# - dynamodb:DeleteItem
# - dynamodb:Scan
# - dynamodb:Query
